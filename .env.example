# 532 — Environment variables
# Copy to .env.local and fill in. The app runs fully with mock data when these are absent.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Maps
NEXT_PUBLIC_MAPBOX_TOKEN=

# Machine translation of seed-data prose (city guides, business descriptions, etc.).
# UI text is hand-translated and needs no key. Set ONE of these to enable data
# translation; without it, seed data stays in English (app still runs fully).
GOOGLE_TRANSLATE_API_KEY=
# or DeepL (free keys end with ":fx"):
DEEPL_API_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin access gate (interim, until Supabase Auth + is_admin is wired).
# /admin is DISABLED unless this is set. Use a long random value, then unlock once
# by visiting /admin?key=YOUR_TOKEN — it sets an httpOnly cookie for 8 hours.
# Generate one: `openssl rand -hex 32`  (or any long random string)
ADMIN_ACCESS_TOKEN=
