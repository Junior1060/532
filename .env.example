# 532 — Environment variables
# Copy to .env.local and fill in. The app runs fully with mock data when these are absent.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — keys from the Stripe dashboard
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret (Stripe dashboard → Developers → Webhooks → your endpoint
# at ${SITE}/api/webhooks/stripe). Required for subscriptions to be recorded.
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs (create products/prices in Stripe, paste the price_… ids).
# Checkout buttons stay disabled with a friendly message until these are set.
STRIPE_PRICE_FEATURED=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_FAN_PREMIUM=

# Maps
NEXT_PUBLIC_MAPBOX_TOKEN=

# Machine translation of seed-data prose (city guides, business descriptions, etc.).
# UI text is hand-translated and needs no key. Set ONE of these to enable data
# translation; without it, seed data stays in English (app still runs fully).
GOOGLE_TRANSLATE_API_KEY=
# or DeepL (free keys end with ":fx"):
DEEPL_API_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin access is role-based via Supabase Auth.
# /admin is gated to signed-in users whose profiles.role = 'admin'.
# To grant access, run in the Supabase SQL editor (after the user has signed up):
#   update public.profiles set role = 'admin'
#   where id = (select id from auth.users where email = 'you@example.com');
